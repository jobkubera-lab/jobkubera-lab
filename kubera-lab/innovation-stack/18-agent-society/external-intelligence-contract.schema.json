{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://kubera-lab.local/schemas/external-intelligence-contract-v3.json",
 "title":"KUBERA External Intelligence Contract v3",
 "type":"object",
 "$defs":{
  "role":{"type":"string","enum":["independent_auditor","red_team","architecture_critic","test_designer","specification_engineer","visual_architecture_agent","research_challenger","open_source_scout","documentation_reviewer","critic_verifier"]},
  "classification":{"type":"string","enum":["PUBLIC","PROJECT"]},
  "constraint":{"type":"string","enum":["do_not_modify_code","return_structured_findings","separate_facts_from_assumptions","focus_security_privacy_correctness","focus_bypass_and_failure_modes","do_not_request_private_context"]},
  "severity":{"type":"string","enum":["info","low","medium","high","critical"]},
  "execution_status":{"type":"string","enum":["completed","provider_error","schema_validation_failed","blocked","timeout"]},
  "finding":{"type":"object","required":["severity","confidence","title"],"properties":{"severity":{"$ref":"#/$defs/severity"},"confidence":{"type":"number","minimum":0,"maximum":1},"title":{"type":"string","minLength":1},"evidence":{"type":"string"},"suggested_fix":{"type":"string"}},"additionalProperties":false},
  "context":{"type":"object","required":["classification","summary","context_hash","redacted_fields","authorization_grant_id"],"properties":{"classification":{"$ref":"#/$defs/classification"},"summary":{"type":"string","minLength":1},"context_hash":{"type":"string","pattern":"^sha256:[0-9a-fA-F]{64}$"},"redacted_fields":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"authorization_grant_id":{"type":["string","null"],"format":"uuid"}},"additionalProperties":false},
  "request":{"type":"object","required":["contract_version","request_id","timestamp","role","target","provider","max_role_classification","timeout_seconds","budget_tokens","context","constraints"],"properties":{"contract_version":{"const":"3.0"},"request_id":{"type":"string","format":"uuid"},"timestamp":{"type":"string","format":"date-time"},"role":{"$ref":"#/$defs/role"},"target":{"type":"string","minLength":1},"provider":{"type":"string","minLength":1},"max_role_classification":{"$ref":"#/$defs/classification"},"timeout_seconds":{"type":"integer","minimum":1,"maximum":600},"budget_tokens":{"type":"integer","minimum":1,"maximum":200000},"context":{"$ref":"#/$defs/context"},"constraints":{"type":"array","items":{"$ref":"#/$defs/constraint"},"uniqueItems":true}},"additionalProperties":false},
  "response":{"type":"object","required":["contract_version","request_id","execution_status","summary","provider","model","model_version","latency_ms","findings","unresolved_risks","provider_error"],"properties":{"contract_version":{"const":"3.0"},"request_id":{"type":"string","format":"uuid"},"execution_status":{"$ref":"#/$defs/execution_status"},"verdict":{"type":["string","null"],"enum":["pass","needs_changes","blocked","inconclusive",null]},"summary":{"type":"string","minLength":1},"provider":{"type":"string","minLength":1},"model":{"type":"string","minLength":1},"model_version":{"type":"string","minLength":1},"latency_ms":{"type":"integer","minimum":0},"findings":{"type":"array","items":{"$ref":"#/$defs/finding"}},"unresolved_risks":{"type":"array","items":{"type":"string"}},"provider_error":{"type":["string","null"]}},"additionalProperties":false}
 },
 "properties":{"request":{"$ref":"#/$defs/request"},"response":{"$ref":"#/$defs/response"}}
}
